{
  "name": "@phreshos/server",
  "version": "0.1.29",
  "description": "The SDK used by a Program's server endpoint.",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "author": "Zohayr SLILEH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhreshOS/server.git"
  },
  "bugs": {
    "url": "https://github.com/PhreshOS/server/issues"
  },
  "homepage": "https://github.com/PhreshOS/server#readme",
  "keywords": [
    "phreshos",
    "server",
    "sdk",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check": "tsc --noEmit",
    "build": "node --run clean && tsc --noEmit false --outDir dist --rootDir source",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:worker": "node scripts/verify-worker.mjs",
    "verify": "node --run check && node --run build && node --run verify:worker && node --run verify:package",
    "prepack": "node --run build"
  },
  "peerDependencies": {
    "@phreshos/core": "^0.1.29"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "devDependencies": {
    "@phreshos/core": "^0.1.29",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  }
}
